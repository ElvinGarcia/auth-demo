+++ b/api/auth/level1.py
@@ -0,0 +1,88 @@
+from fastapi import APIRouter, Cookie, HTTPException, Response
+from pydantic import BaseModel, Field
+
+from api.db import db
+from api.passwords import hash_password, verify_password
+from api.sessions import (
+    clear_session_cookie,
+    create_session,
+    delete_session,
+    get_user_by_session,
+    set_session_cookie,
+)
+
+LEVEL = 1
+router = APIRouter(prefix="/api/level1", tags=["level1"])
+
+# Same weak passwords as Level 0, but stored hashed. A hash cannot stop a weak
+# password from being guessed; it only stops the stored value being read.
+SEED_ACCOUNTS = [
+    ("admin", "admin123"),
+    ("alice", "password1"),
+    ("bob", "qwerty"),
+    ("carol", "letmein"),
+]
+
+
+def seed() -> None:
+    with db() as conn:
+        for username, password in SEED_ACCOUNTS:
+            exists = conn.execute(
+                "SELECT 1 FROM users WHERE level = ? AND username = ?", (LEVEL, username)
+            ).fetchone()
+            if not exists:
+                conn.execute(
+                    "INSERT INTO users (level, username, password) VALUES (?, ?, ?)",
+                    (LEVEL, username, hash_password(password)),
+                )
+
+
+class Credentials(BaseModel):
+    username: str = Field(min_length=1, max_length=32)
+    # Still weak on purpose: hashing does not fix a bad password policy.
+    password: str = Field(min_length=1, max_length=128)
+
+
+@router.post("/login")
+def login(creds: Credentials, response: Response):
+    # Still no rate limiting: online guessing works exactly as in Level 0.
+    with db() as conn:
+        row = conn.execute(
+            "SELECT id, password FROM users WHERE level = ? AND username = ?",
+            (LEVEL, creds.username),
+        ).fetchone()
+
+        created = False
+        if row is None:
+            # First login with a new username creates the account (no registration).
+            cur = conn.execute(
+                "INSERT OR IGNORE INTO users (level, username, password) VALUES (?, ?, ?)",
+                (LEVEL, creds.username, hash_password(creds.password)),
+            )
+            created = cur.rowcount == 1
+            row = conn.execute(
+                "SELECT id, password FROM users WHERE level = ? AND username = ?",
+                (LEVEL, creds.username),
+            ).fetchone()
+
+    if not created:
+        if not verify_password(creds.password, row["password"]):
+            raise HTTPException(status_code=401, detail="Invalid username or password")
+
+    set_session_cookie(response, create_session(row["id"]))
+    return {"username": creds.username, "created": created}
+
+
+@router.get("/me")
+def me(session: str | None = Cookie(default=None)):
+    user = get_user_by_session(session)
+    if user is None or user["level"] != LEVEL:
+        raise HTTPException(status_code=401, detail="Not logged in")
+    return {"username": user["username"], "level": user["level"]}
+
+
+@router.post("/logout")
+def logout(response: Response, session: str | None = Cookie(default=None)):
+    delete_session(session)
+    clear_session_cookie(response)
+    return {"ok": True}
diff --git a/api/auth/level1_attacker.py b/api/auth/level1_attacker.py
new file mode 100644
index 0000000..2a21d2d
--- /dev/null
+++ b/api/auth/level1_attacker.py
@@ -0,0 +1,45 @@
+import os
+
+from fastapi import APIRouter, Cookie, HTTPException
+
+from api.auth.level1 import LEVEL, SEED_ACCOUNTS
+from api.db import db
+from api.sessions import get_user_by_session
+
+router = APIRouter(prefix="/api/level1/attacker", tags=["level1-attacker"])
+
+
+def _enabled() -> bool:
+    # Set ATTACKER_VIEW=0 to switch the whole attacker view off.
+    return os.environ.get("ATTACKER_VIEW", "1") == "1"
+
+
+@router.get("/dump")
+def dump(session: str | None = Cookie(default=None)):
+    """What a thief holding a copy of the user table sees at Level 1.
+
+    Seeded demo accounts plus the caller's own row, same privacy rule as Level 0.
+    """
+    if not _enabled():
+        raise HTTPException(status_code=404, detail="Not found")
+
+    me = get_user_by_session(session)
+    own_id = me["id"] if me and me["level"] == LEVEL else -1
+    seeded = [username for username, _ in SEED_ACCOUNTS]
+    marks = ",".join("?" * len(seeded))  # only "?" placeholders, never user input
+
+    with db() as conn:
+        rows = conn.execute(
+            f"""SELECT username, password FROM users
+                WHERE level = ? AND (username IN ({marks}) OR id = ?)
+                ORDER BY id""",
+            (LEVEL, *seeded, own_id),
+        ).fetchall()
+        total = conn.execute(
+            "SELECT COUNT(*) FROM users WHERE level = ?", (LEVEL,)
+        ).fetchone()[0]
+
+    return {
+        "rows": [{"username": r["username"], "stored": r["password"]} for r in rows],
+        "hidden": total - len(rows),
+    }
